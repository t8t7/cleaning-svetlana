---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена — Светлана" description="Запрошенная страница не найдена.">
  <main class="not-found">
    <div class="container">
      <h1>404</h1>
      <p>Страница не найдена.</p>
      <a class="btn btn-primary" href="/">На главную</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 3rem 0;
  }

  h1 {
    font-size: 4rem;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
  }

  p {
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
</style>
