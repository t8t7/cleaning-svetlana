---
import { site } from '../data/site.js';
---

<section class="section about" id="about">
  <div class="container about-grid">
    <div class="about-media reveal">
      <img
        src="/images/about-svetlana.jpg"
        alt={`${site.brand} — уборка квартир с заботой, ${site.city}`}
        width="720"
        height="1067"
        loading="lazy"
      />
    </div>
    <div class="about-copy reveal">
      <span class="eyebrow">О нас</span>
      <h2>Личный подход вместо конвейера</h2>
      <p>
        Меня зовут Светлана. Я и небольшая команда (обычно {site.teamSize} человек) делаем уборку так, будто это наш
        собственный дом: аккуратно, по договорённости и с вниманием к мелочам. Клиенты часто отмечают: договорились
        быстро, приехали вовремя, сделали всё как обещали.
      </p>
      <ul>
        <li>Опыт работы: {site.experience}</li>
        <li>Объекты: квартира, дом, офис</li>
        <li>Минимальный заказ: {site.minOrder}</li>
        <li>Средства привозим с собой</li>
      </ul>
      <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Позвонить</a>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .about-media {
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    background: #e7f5f2;
    line-height: 0;
  }

  .about-media img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    object-position: center top;
  }

  .about-copy h2 {
    color: var(--color-forest);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    margin-bottom: 0.85rem;
  }

  .about-copy p {
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .about-copy ul {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .about-copy li {
    padding-left: 1.2rem;
    position: relative;
    font-weight: 600;
  }

  .about-copy li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-teal);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 2.5rem;
    }
  }
</style>
