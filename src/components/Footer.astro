---
import { site } from '../data/site.js';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong class="footer-brand">{site.brand}</strong>
      <p>Уборка квартир с заботой о вашем доме</p>
    </div>
    <div>
      <h3>Контакты</h3>
      <p>{site.region}, {site.city}</p>
      <p>{site.address}</p>
      <p><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
      <p>
        <a href={site.avitoUrl} target="_blank" rel="noopener noreferrer">Мы на Авито</a>
      </p>
    </div>
    <div>
      <h3>Навигация</h3>
      <a href="#services">Услуги</a>
      <a href="#pricing">Цены</a>
      <a href="#reviews">Отзывы</a>
      <a href="#faq">FAQ</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <div class="footer-legal">
      <p>© {new Date().getFullYear()} {site.brand}. Уборка квартир в {site.city}.</p>
      <p>Персональные данные обрабатываются только для связи по заявке.</p>
    </div>

    <div class="dev-credits">
      <p class="dev-label">Сайт разработал</p>
      <div class="dev-links">
        <a
          class="dev-link"
          href={site.developer.site}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={site.developer.icon}
            alt={site.developer.name}
            width="22"
            height="22"
            loading="lazy"
            aria-hidden="true"
          />
          <span>{site.developer.name}</span>
        </a>
        <a
          class="dev-link"
          href={site.developer.telegram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Telegram ${site.developer.telegramHandle}`}
        >
          <img
            src={site.developer.telegramIcon}
            alt="Telegram"
            width="18"
            height="18"
            loading="lazy"
            aria-hidden="true"
          />
          <span>{site.developer.telegramHandle}</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-forest);
    color: rgba(255, 255, 255, 0.9);
    padding: 2.5rem 0 1.5rem;
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: 1.75rem;
    }
  }

  .footer-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .footer-brand {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .site-footer h3 {
    font-size: 0.95rem;
    margin-bottom: 0.55rem;
    color: #bbf7d0;
  }

  .site-footer p,
  .site-footer a {
    margin: 0 0 0.35rem;
    color: rgba(255, 255, 255, 0.86);
  }

  .site-footer a:hover {
    color: white;
  }

  .footer-grid > div:last-child {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1rem;
    display: grid;
    gap: 1rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-legal p {
    margin: 0 0 0.25rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .dev-credits {
    display: grid;
    gap: 0.45rem;
  }

  .dev-label {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .dev-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .dev-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    max-width: 100%;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.92) !important;
    margin: 0 !important;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .dev-link:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .dev-link img {
    display: block;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .dev-link span {
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 800px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr 0.8fr;
    }
  }

  @media (min-width: 800px) and (max-width: 999px) {
    .footer-bottom {
      grid-template-columns: 1fr;
    }

    .dev-credits {
      justify-items: start;
      text-align: left;
    }

    .dev-links {
      justify-content: flex-start;
    }
  }

  @media (min-width: 1000px) {
    .footer-bottom {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .dev-credits {
      justify-items: end;
      text-align: right;
    }

    .dev-links {
      justify-content: flex-end;
    }
  }
</style>
