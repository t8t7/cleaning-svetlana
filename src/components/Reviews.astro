---
import AvitoBadge from './AvitoBadge.astro';
import { reviews, site } from '../data/site.js';
---

<section class="section reviews" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Отзывы</span>
      <h2>{site.rating.toFixed(1)} — так о нас пишут клиенты</h2>
      <p>
        Рейтинг {site.rating.toFixed(1)} на основе {site.reviewCount} отзывов. Чаще всего отмечают: быстрая
        договорённость без лишних фото, пунктуальность, труднодоступные места и цену как договорились.
      </p>
    </div>

    <div class="rating-banner reveal">
      <div class="score">{site.rating.toFixed(1)}</div>
      <div class="rating-copy">
        <strong>{site.reviewCount} отзывов клиентов</strong>
        <p>Скорость договорённости · Аккуратность · Честная цена</p>
      </div>
      <AvitoBadge />
    </div>

    <div class="review-carousel reveal" data-review-carousel>
      <div class="review-track" data-review-track tabindex="0" aria-label="Отзывы клиентов, листайте вбок">
        {reviews.map((review, index) => (
          <article class="review" data-review-slide aria-roledescription="slide" aria-label={`Отзыв ${index + 1} из ${reviews.length}`}>
            <div class="stars" aria-label="Оценка 5 из 5">★★★★★</div>
            <p>{review.text}</p>
            <footer>{review.name}</footer>
          </article>
        ))}
      </div>
      <div class="review-controls">
        <p class="review-counter" data-review-counter>1 / {reviews.length}</p>
        <div class="review-dots" data-review-dots aria-hidden="true">
          {reviews.map((_, index) => (
            <span class:list={['review-dot', { 'is-active': index === 0 }]}></span>
          ))}
        </div>
      </div>
    </div>

    <div class="reviews-more reveal">
      <a class="btn btn-ghost" href={site.avitoUrl} target="_blank" rel="noopener noreferrer">
        Все отзывы на Авито
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector('[data-review-track]');
  const counter = document.querySelector('[data-review-counter]');
  const dots = document.querySelectorAll('[data-review-dots] .review-dot');
  const slides = track ? [...track.querySelectorAll('[data-review-slide]')] : [];

  if (track && slides.length) {
    const update = () => {
      // Desktop uses a static grid — no carousel chrome to sync.
      if (track.scrollWidth <= track.clientWidth + 1) return;

      const trackLeft = track.getBoundingClientRect().left;
      let bestIndex = 0;
      let bestDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.getBoundingClientRect().left - trackLeft);
        if (dist < bestDist) {
          bestDist = dist;
          bestIndex = i;
        }
      });

      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll > 0 && track.scrollLeft >= maxScroll - 2) {
        bestIndex = slides.length - 1;
      }

      if (counter) counter.textContent = `${bestIndex + 1} / ${slides.length}`;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === bestIndex));
    };

    track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .reviews {
    background: linear-gradient(180deg, rgba(240, 253, 250, 0.85), transparent);
  }

  .rating-banner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .rating-copy {
    flex: 1 1 12rem;
    min-width: 0;
  }

  .score {
    min-width: 64px;
    height: 64px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--color-lime), #4d7c0f);
    color: white;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
  }

  .rating-banner strong {
    color: var(--color-forest);
  }

  .rating-banner p {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
  }

  .review-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(100%, 22rem), 85%);
    gap: 0.85rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.15rem;
    padding: 0.15rem 0.15rem 0.65rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .review {
    scroll-snap-align: start;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.15rem;
    min-width: 0;
    min-height: 12.5rem;
    display: flex;
    flex-direction: column;
  }

  .stars {
    color: #ca8a04;
    letter-spacing: 0.08em;
    margin-bottom: 0.55rem;
  }

  .review p {
    margin: 0;
    color: var(--color-charcoal);
    flex: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    overflow: hidden;
  }

  .review footer {
    margin-top: 0.85rem;
    font-weight: 700;
    color: var(--color-teal);
  }

  .review-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .review-counter {
    margin: 0;
    font-weight: 700;
    color: var(--color-forest);
    font-variant-numeric: tabular-nums;
  }

  .review-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    max-width: min(100%, 14rem);
  }

  .review-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #99f6e4;
  }

  .review-dot.is-active {
    background: var(--color-teal);
    transform: scale(1.2);
  }

  .reviews-more {
    margin-top: 1.15rem;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 800px) {
    .review-track {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: unset;
      overflow: visible;
      scroll-snap-type: none;
      padding: 0;
    }

    .review {
      scroll-snap-align: unset;
      min-height: 0;
    }

    .review-controls {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .review-track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
