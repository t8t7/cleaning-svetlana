---
import { site } from '../data/site.js';

const fallbackItems = [
  {
    id: 'demo-kitchen',
    url: '/images/works/result-kitchen-detail.jpg',
    thumbUrl: '/images/works/result-kitchen-detail.jpg',
    caption: 'Кухня после генеральной уборки',
  },
  {
    id: 'demo-after-kitchen',
    url: '/images/works/after-kitchen.jpg',
    thumbUrl: '/images/works/after-kitchen.jpg',
    caption: 'Чистая кухня — готово к жизни',
  },
  {
    id: 'demo-window',
    url: '/images/works/after-window.jpg',
    thumbUrl: '/images/works/after-window.jpg',
    caption: 'Окна без разводов',
  },
];
---

<section class="section clean-frames" id="frames" aria-labelledby="frames-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Галерея</span>
      <h2 id="frames-title">Фото работ</h2>
      <p>Реальный результат в квартирах — звоните и записывайтесь.</p>
    </div>

    <div class="frames-grid" data-frames-grid>
      {fallbackItems.map((item, index) => (
        <article class="frame-card reveal" data-frame-id={item.id}>
          <button
            type="button"
            class="frame-media"
            data-open-frame
            data-url={item.url}
            data-caption={item.caption}
          >
            <img
              src={item.thumbUrl || item.url}
              alt={item.caption}
              width="720"
              height="540"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
              sizes="(min-width: 1000px) 33vw, (min-width: 700px) 50vw, 100vw"
            />
          </button>
        </article>
      ))}
    </div>

    <div class="frames-cta reveal">
      <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Позвонить и записаться</a>
    </div>
  </div>
</section>

<dialog class="frame-dialog" data-frame-dialog>
  <form method="dialog" class="frame-dialog-inner">
    <button class="frame-dialog-close" value="close" aria-label="Закрыть">×</button>
    <img data-dialog-img alt="" decoding="async" />
    <p data-dialog-caption></p>
  </form>
</dialog>

<script>
  const grid = document.querySelector('[data-frames-grid]');
  const dialog = document.querySelector('[data-frame-dialog]');
  const dialogImg = document.querySelector('[data-dialog-img]');
  const dialogCaption = document.querySelector('[data-dialog-caption]');

  const escapeAttr = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;');

  const cardHtml = (item, index) => {
    const thumb = item.thumbUrl || item.url;
    const full = item.url || thumb;
    const loading = index < 2 ? 'eager' : 'lazy';
    return `
    <article class="frame-card reveal is-visible" data-frame-id="${escapeAttr(item.id)}">
      <button type="button" class="frame-media" data-open-frame data-url="${escapeAttr(full)}" data-caption="${escapeAttr(item.caption)}">
        <img src="${escapeAttr(thumb)}" alt="${escapeAttr(item.caption)}" width="720" height="540" loading="${loading}" decoding="async" sizes="(min-width: 1000px) 33vw, (min-width: 700px) 50vw, 100vw" />
      </button>
    </article>`;
  };

  const bindCard = (card) => {
    const openBtn = card.querySelector('[data-open-frame]');
    openBtn?.addEventListener('click', () => {
      if (!dialog || !dialogImg || !dialogCaption) return;
      dialogImg.setAttribute('src', openBtn.getAttribute('data-url') || '');
      dialogImg.setAttribute('alt', openBtn.getAttribute('data-caption') || '');
      dialogCaption.textContent = openBtn.getAttribute('data-caption') || '';
      dialog.showModal();
    });
  };

  document.querySelectorAll('[data-frame-id]').forEach(bindCard);

  fetch('/api/works', { headers: { Accept: 'application/json' } })
    .then((res) => (res.ok ? res.json() : Promise.reject()))
    .then((data) => {
      if (!grid || !Array.isArray(data.items) || !data.items.length) return;
      grid.innerHTML = data.items.map((item, index) => cardHtml(item, index)).join('');
      grid.querySelectorAll('[data-frame-id]').forEach(bindCard);
    })
    .catch(() => {
      /* keep demo fallback */
    });
</script>

<style>
  .frames-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  /* :global — карточки пересобираются из /api/works */
  .clean-frames :global(.frame-card) {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    min-width: 0;
  }

  .clean-frames :global(.frame-media) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #ecfdf5;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .clean-frames :global(.frame-media img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
    background: #ecfdf5;
  }

  .frames-cta {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .frame-dialog {
    border: 0;
    padding: 0;
    border-radius: 18px;
    max-width: min(920px, calc(100% - 2rem));
    background: #041f1c;
    color: #fff;
  }

  .frame-dialog::backdrop {
    background: rgba(4, 31, 28, 0.72);
  }

  .frame-dialog-inner {
    margin: 0;
    position: relative;
  }

  .frame-dialog-inner img {
    width: 100%;
    max-height: 75vh;
    object-fit: contain;
    display: block;
    background: #000;
  }

  .frame-dialog-inner p {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
  }

  .frame-dialog-close {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 2.2rem;
    height: 2.2rem;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.4rem;
    cursor: pointer;
  }

  @media (min-width: 700px) {
    .frames-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .frames-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
