---
import { site } from '../data/site.js';

const PREVIEW_MOBILE = 4;
const PREVIEW_DESKTOP = 6;

const fallbackItems = [
  {
    id: 'demo-kitchen',
    url: '/images/works/result-kitchen-detail.jpg',
    thumbUrl: '/images/works/result-kitchen-detail.jpg',
    caption: 'Кухня после генеральной уборки',
  },
  {
    id: 'demo-after-kitchen',
    url: '/images/works/after-kitchen.jpg',
    thumbUrl: '/images/works/after-kitchen.jpg',
    caption: 'Чистая кухня — готово к жизни',
  },
  {
    id: 'demo-window',
    url: '/images/works/after-window.jpg',
    thumbUrl: '/images/works/after-window.jpg',
    caption: 'Окна без разводов',
  },
];
---

<section
  class="section clean-frames"
  id="frames"
  aria-labelledby="frames-title"
  data-preview-mobile={PREVIEW_MOBILE}
  data-preview-desktop={PREVIEW_DESKTOP}
>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Галерея</span>
      <h2 id="frames-title">Фото работ</h2>
      <p>Реальный результат в квартирах — листайте галерею, без длинной ленты на странице.</p>
    </div>

    <div class="frames-grid" data-frames-grid>
      {fallbackItems.slice(0, PREVIEW_MOBILE).map((item, index) => (
        <article class="frame-card reveal" data-frame-id={item.id}>
          <button
            type="button"
            class="frame-media"
            data-open-frame
            data-index={index}
            data-url={item.url}
            data-caption={item.caption}
          >
            <img
              src={item.thumbUrl || item.url}
              alt={item.caption}
              width="720"
              height="540"
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
              sizes="(min-width: 1000px) 33vw, (min-width: 700px) 50vw, 50vw"
            />
          </button>
        </article>
      ))}
    </div>

    <div class="frames-actions reveal">
      <button type="button" class="btn btn-ghost" data-open-all-frames hidden>
        Смотреть все фото
      </button>
      <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Позвонить и записаться</a>
    </div>
  </div>
</section>

<dialog class="frame-dialog" data-frame-dialog>
  <div class="frame-dialog-inner">
    <button type="button" class="frame-dialog-close" data-close-frame aria-label="Закрыть">×</button>
    <button type="button" class="frame-nav frame-nav-prev" data-frame-prev aria-label="Предыдущее фото">‹</button>
    <button type="button" class="frame-nav frame-nav-next" data-frame-next aria-label="Следующее фото">›</button>
    <img data-dialog-img alt="" decoding="async" draggable="false" />
    <div class="frame-dialog-meta">
      <p data-dialog-caption></p>
      <p class="frame-dialog-counter" data-dialog-counter></p>
    </div>
  </div>
</dialog>

<script>
  const section = document.querySelector('.clean-frames');
  const grid = document.querySelector('[data-frames-grid]');
  const openAllBtn = document.querySelector('[data-open-all-frames]');
  const dialog = document.querySelector('[data-frame-dialog]');
  const dialogImg = document.querySelector('[data-dialog-img]');
  const dialogCaption = document.querySelector('[data-dialog-caption]');
  const dialogCounter = document.querySelector('[data-dialog-counter]');
  const closeBtn = document.querySelector('[data-close-frame]');
  const prevBtn = document.querySelector('[data-frame-prev]');
  const nextBtn = document.querySelector('[data-frame-next]');
  const previewMobile = Number(section?.getAttribute('data-preview-mobile') || 4);
  const previewDesktop = Number(section?.getAttribute('data-preview-desktop') || 6);
  const desktopQuery = window.matchMedia('(min-width: 700px)');

  const getPreviewLimit = () => (desktopQuery.matches ? previewDesktop : previewMobile);

  let items = [];
  let currentIndex = 0;
  let lastPreviewLimit = getPreviewLimit();
  let touchStartX = 0;
  let touchDeltaX = 0;
  const prefetchedUrls = new Set();

  const escapeAttr = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;');

  const fullUrl = (item) => item?.url || item?.thumbUrl || '';

  const prefetchUrl = (url) => {
    if (!url || prefetchedUrls.has(url)) return;
    prefetchedUrls.add(url);
    const img = new Image();
    img.decoding = 'async';
    img.src = url;
  };

  const prefetchAround = (index) => {
    if (!items.length) return;
    // Current + next two + previous: swipe feels instant on slow mobile nets.
    for (const offset of [0, 1, 2, -1]) {
      const target = (index + offset + items.length) % items.length;
      prefetchUrl(fullUrl(items[target]));
    }
  };

  const cardHtml = (item, index) => {
    const thumb = item.thumbUrl || item.url;
    const full = item.url || thumb;
    const loading = index < 2 ? 'eager' : 'lazy';
    return `
    <article class="frame-card reveal is-visible" data-frame-id="${escapeAttr(item.id)}">
      <button type="button" class="frame-media" data-open-frame data-index="${index}" data-url="${escapeAttr(full)}" data-caption="${escapeAttr(item.caption)}">
        <img src="${escapeAttr(thumb)}" alt="${escapeAttr(item.caption)}" width="720" height="540" loading="${loading}" decoding="async" sizes="(min-width: 1000px) 33vw, (min-width: 700px) 50vw, 50vw" />
      </button>
    </article>`;
  };

  const showFrame = (index) => {
    if (!items.length || !dialog || !dialogImg || !dialogCaption || !dialogCounter) return;
    currentIndex = (index + items.length) % items.length;
    const item = items[currentIndex];
    const full = fullUrl(item);
    dialogImg.setAttribute('src', full);
    dialogImg.setAttribute('alt', item.caption || '');
    dialogCaption.textContent = item.caption || '';
    dialogCounter.textContent = `${currentIndex + 1} / ${items.length}`;
    if (typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
    prefetchAround(currentIndex);
  };

  const bindGrid = () => {
    grid?.querySelectorAll('[data-open-frame]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.getAttribute('data-index') || 0);
        showFrame(index);
      });
    });
  };

  const renderPreview = (list) => {
    items = Array.isArray(list) ? list : [];
    if (!grid) return;
    const previewLimit = getPreviewLimit();
    lastPreviewLimit = previewLimit;
    // Only the newest N cards stay on the page; the rest open via the button.
    const preview = items.slice(0, previewLimit);
    grid.innerHTML = preview.map((item, index) => cardHtml(item, index)).join('');
    bindGrid();

    if (openAllBtn) {
      if (items.length > previewLimit) {
        openAllBtn.hidden = false;
        openAllBtn.textContent = `Смотреть все фото (${items.length})`;
      } else if (items.length > 1) {
        openAllBtn.hidden = false;
        openAllBtn.textContent = `Смотреть фото (${items.length})`;
      } else {
        openAllBtn.hidden = true;
      }
    }

    // Warm the first shots so "Смотреть все" opens without a blank pause.
    if (items.length) prefetchAround(0);
  };

  openAllBtn?.addEventListener('click', () => showFrame(0));
  closeBtn?.addEventListener('click', () => dialog?.close());
  prevBtn?.addEventListener('click', () => showFrame(currentIndex - 1));
  nextBtn?.addEventListener('click', () => showFrame(currentIndex + 1));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener('keydown', (event) => {
    if (!dialog.open) return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      showFrame(currentIndex - 1);
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      showFrame(currentIndex + 1);
    }
  });

  dialogImg?.addEventListener(
    'touchstart',
    (event) => {
      touchStartX = event.changedTouches[0]?.clientX || 0;
      touchDeltaX = 0;
    },
    { passive: true }
  );

  dialogImg?.addEventListener(
    'touchmove',
    (event) => {
      touchDeltaX = (event.changedTouches[0]?.clientX || 0) - touchStartX;
    },
    { passive: true }
  );

  dialogImg?.addEventListener(
    'touchend',
    () => {
      if (Math.abs(touchDeltaX) < 40) return;
      if (touchDeltaX < 0) showFrame(currentIndex + 1);
      else showFrame(currentIndex - 1);
    },
    { passive: true }
  );

  const demoItems = [
    {
      id: 'demo-kitchen',
      url: '/images/works/result-kitchen-detail.jpg',
      thumbUrl: '/images/works/result-kitchen-detail.jpg',
      caption: 'Кухня после генеральной уборки',
      createdAt: '2026-11-11T12:00:00.000Z',
    },
    {
      id: 'demo-after-kitchen',
      url: '/images/works/after-kitchen.jpg',
      thumbUrl: '/images/works/after-kitchen.jpg',
      caption: 'Чистая кухня — готово к жизни',
      createdAt: '2026-11-11T12:00:01.000Z',
    },
    {
      id: 'demo-window',
      url: '/images/works/after-window.jpg',
      thumbUrl: '/images/works/after-window.jpg',
      caption: 'Окна без разводов',
      createdAt: '2026-11-11T12:00:02.000Z',
    },
  ];

  renderPreview(demoItems);

  const sortNewestFirst = (list) =>
    [...list].sort((a, b) => {
      const tb = Date.parse(b?.createdAt || '') || 0;
      const ta = Date.parse(a?.createdAt || '') || 0;
      if (tb !== ta) return tb - ta;
      return String(b?.id || '').localeCompare(String(a?.id || ''));
    });

  const applyWorks = (payload) => {
    const list = Array.isArray(payload?.items) ? payload.items : [];
    // Keep demos in the portfolio even if they were dropped from the API store.
    const byId = new Map(list.map((item) => [item.id, item]));
    for (const demo of demoItems) {
      if (!byId.has(demo.id)) byId.set(demo.id, demo);
    }
    // Newest → top-left, then right/down; overflow stays behind "Смотреть фото".
    renderPreview(sortNewestFirst([...byId.values()]));
  };

  const loadWorks = () =>
    fetch('/api/works', { headers: { Accept: 'application/json' }, cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(applyWorks);

  let worksPollTimer = null;

  const startWorksPolling = () => {
    if (worksPollTimer != null) return;
    worksPollTimer = window.setInterval(() => {
      if (document.visibilityState !== 'visible') return;
      loadWorks().catch(() => {});
    }, 1000);
  };

  const stopWorksPolling = () => {
    if (worksPollTimer == null) return;
    window.clearInterval(worksPollTimer);
    worksPollTimer = null;
  };

  // Do not open EventSource for /api/works/stream until system Caddy flushes it.
  // A buffered SSE holds a connection forever and can starve polling on mobile.

  const refreshWorks = () => {
    loadWorks().catch(() => {
      /* keep current / demo gallery */
    });
  };

  refreshWorks();
  startWorksPolling();

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      refreshWorks();
      startWorksPolling();
    } else {
      stopWorksPolling();
    }
  });
  window.addEventListener('pageshow', refreshWorks);
  window.addEventListener('focus', refreshWorks);

  const onViewportChange = () => {
    if (getPreviewLimit() === lastPreviewLimit) return;
    renderPreview(items);
  };
  if (typeof desktopQuery.addEventListener === 'function') {
    desktopQuery.addEventListener('change', onViewportChange);
  } else if (typeof desktopQuery.addListener === 'function') {
    desktopQuery.addListener(onViewportChange);
  }
  window.addEventListener('resize', onViewportChange);
</script>

<style>
  .frames-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .clean-frames :global(.frame-card) {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    min-width: 0;
  }

  .clean-frames :global(.frame-media) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #ecfdf5;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .clean-frames :global(.frame-media img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
    background: #ecfdf5;
  }

  .frames-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .frame-dialog {
    border: 0;
    padding: 0;
    border-radius: 18px;
    width: min(920px, calc(100% - 1.25rem));
    max-width: min(920px, calc(100% - 1.25rem));
    background: #041f1c;
    color: #fff;
  }

  .frame-dialog::backdrop {
    background: rgba(4, 31, 28, 0.72);
  }

  .frame-dialog-inner {
    margin: 0;
    position: relative;
  }

  .frame-dialog-inner img {
    width: 100%;
    max-height: 72vh;
    object-fit: contain;
    display: block;
    background: #000;
    touch-action: pan-y;
    user-select: none;
  }

  .frame-dialog-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem 1rem;
  }

  .frame-dialog-meta p {
    margin: 0;
  }

  .frame-dialog-counter {
    flex: 0 0 auto;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #99f6e4;
  }

  .frame-dialog-close,
  .frame-nav {
    position: absolute;
    z-index: 2;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
  }

  .frame-dialog-close {
    top: 0.55rem;
    right: 0.55rem;
    width: 2.2rem;
    height: 2.2rem;
    font-size: 1.4rem;
  }

  .frame-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.6rem;
    line-height: 1;
  }

  .frame-nav-prev {
    left: 0.45rem;
  }

  .frame-nav-next {
    right: 0.45rem;
  }

  @media (min-width: 700px) {
    .frames-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>
