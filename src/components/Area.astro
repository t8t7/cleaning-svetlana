---
import { site } from '../data/site.js';
---

<section class="section" id="area">
  <div class="container area">
    <div class="section-head reveal">
      <span class="eyebrow">География</span>
      <h2>Выезжаем по всей {site.city.replace(/а$/, 'е')}</h2>
      <p>{site.areaNote}. База: {site.region}, {site.city}, {site.address}.</p>
    </div>
    <div class="area-card reveal">
      <div>
        <h3>Адрес</h3>
        <p>{site.region}, {site.city}, {site.address}</p>
      </div>
      <div>
        <h3>Связь</h3>
        <p>
          <a href={`tel:${site.phoneTel}`}>Позвонить</a>
        </p>
      </div>
      <div>
        <h3>Выезд</h3>
        <p>По всему городу, в том числе в день заказа</p>
      </div>
    </div>
  </div>
</section>

<style>
  .area-card {
    display: grid;
    gap: 1rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow-soft);
  }

  .area-card h3 {
    color: var(--color-forest);
    margin-bottom: 0.35rem;
    font-size: 1rem;
  }

  .area-card p {
    margin: 0;
    color: var(--color-muted);
  }

  .area-card a {
    color: var(--color-teal);
    font-weight: 700;
  }

  @media (min-width: 800px) {
    .area-card {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
