---
import { site } from '../data/site.js';
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="logo" href="#top" aria-label={`${site.brand} — наверх`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-text">
        <strong>{site.brand}</strong>
        <small>уборка с заботой</small>
      </span>
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <a href="#schedule">Расписание</a>
      <a href="#pricing">Цены</a>
      <a href="#services">Услуги</a>
      <a href="#frames">Фото работ</a>
      <a href="#reviews">Отзывы</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="header-actions">
      <a class="phone" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      <a class="btn btn-primary header-cta" href={`tel:${site.phoneTel}`}>Позвонить</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-toggle">
        <span class="sr-only">Меню</span>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <a href="#schedule">Расписание</a>
    <a href="#pricing">Цены</a>
    <a href="#services">Услуги</a>
    <a href="#frames">Фото работ</a>
    <a href="#reviews">Отзывы</a>
    <a href="#faq">FAQ</a>
    <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
    <a class="btn btn-primary" href={`tel:${site.phoneTel}`}>Позвонить</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--header-h);
    height: auto;
    background: rgba(248, 250, 249, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(209, 231, 227, 0.9);
  }

  .header-inner {
    min-height: var(--header-h);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .logo-mark {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, #bef264, transparent 45%),
      linear-gradient(145deg, var(--color-teal), var(--color-forest));
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .logo-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-forest);
    letter-spacing: -0.02em;
  }

  .logo-text small {
    color: var(--color-muted);
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav {
    display: none;
    gap: 1.25rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .nav a:hover {
    color: var(--color-forest);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .phone {
    display: none;
    font-weight: 700;
    color: var(--color-forest);
    white-space: nowrap;
  }

  .menu-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-white);
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
  }

  .menu-btn span:not(.sr-only) {
    width: 18px;
    height: 2px;
    background: var(--color-forest);
    border-radius: 2px;
  }

  .mobile-nav {
    display: grid;
    gap: 0.85rem;
    padding: 1rem clamp(1rem, 4vw, 1.25rem) 1.25rem;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  /* author display:grid must not override HTML hidden */
  .mobile-nav[hidden] {
    display: none !important;
  }

  .mobile-nav a {
    font-weight: 600;
    color: var(--color-forest);
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }

    .menu-btn,
    .mobile-nav {
      display: none !important;
    }
  }

  @media (min-width: 900px) and (max-width: 1099px) {
    .nav {
      gap: 0.75rem;
      font-size: 0.92rem;
    }

    .phone {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .phone {
      display: inline;
    }
  }

  @media (max-width: 899px) {
    .header-cta {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };
    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      const first = panel.querySelector('a');
      if (first instanceof HTMLElement) first.focus();
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) closeMenu();
      else openMenu();
    });
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
