# System Caddy on VPS (NOT the Docker Caddy service).
# Install to: /etc/caddy/Caddyfile
# Domain gets automatic HTTPS via Let's Encrypt.

test-fas.ru {
	@availabilityStream path /api/availability/stream
	handle @availabilityStream {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		encode gzip zstd
		reverse_proxy 127.0.0.1:3000
	}
}
