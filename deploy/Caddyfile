# System Caddy on VPS (NOT the Docker Caddy service).
# Install to: /etc/caddy/Caddyfile
# Domain gets automatic HTTPS via Let's Encrypt.

test-fas.ru {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# SSE must bypass gzip and flush immediately (availability + prices).
	@sseStreams path /api/availability/stream /api/pricing/stream
	handle @sseStreams {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		encode gzip zstd
		reverse_proxy 127.0.0.1:3000
	}
}
