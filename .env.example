PORT=3000
NODE_ENV=production
# Secret for Android app / APK API writes (Authorization: Bearer <token>)
# Set a long random value on the VPS — never commit the real token.
MASTER_TOKEN=change-me-master-token
# Password for https://test-fas.ru/admin (device list, block, token rotate)
ADMIN_PASSWORD=change-me-admin-password
# Short PIN for https://test-fas.ru/app-download (Android APK download page)
APK_DOWNLOAD_PIN=change-me-apk-pin
