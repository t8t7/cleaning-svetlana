PORT=3000
NODE_ENV=production
# Secret for Android app / APK API writes (Authorization: Bearer <token>)
# Set a long random value on the VPS — never commit the real token.
MASTER_TOKEN=change-me-master-token
# Unlisted panel path. Scanners probe /admin, so never use that word.
# One segment, 8+ characters: letters, digits, hyphen. Example: sv-h7k4m2
ADMIN_PATH=
# Google sign-in for the panel (no site password).
# Create a Web OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://test-fas.ru/<ADMIN_PATH>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts that may open the panel
ADMIN_GOOGLE_EMAILS=you@gmail.com
# Public site origin used in the Google redirect. Leave as-is for production.
ADMIN_PUBLIC_ORIGIN=https://test-fas.ru
# Optional cookie signing secret (32+ chars). If empty, the server stores one in data/admin-session.secret
ADMIN_SESSION_SECRET=
# Short PIN for https://test-fas.ru/app-download (Android APK download page)
APK_DOWNLOAD_PIN=change-me-apk-pin
